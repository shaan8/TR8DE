# Copy to .env and fill in. Never commit .env.
#
# Judges need at most two things here:
#   1. A model key. Qwen Cloud (DASHSCOPE_API_KEY) is the default; DeepSeek, OpenRouter (free models) and Anthropic
#      also work, and the first one with a key is used. The local demo runs without one; live payments need one.
#   2. Live Sepolia only: nothing, at first. ./scripts/live.sh creates PRIVATE_KEY and prints its address; send it
#      0.02 Sepolia test ETH from a faucet (free, no value; links in the README) and rerun.
# WhatsApp and Telegram (further down) are optional: the WhatsApp simulator covers the demo.

# ---- Model (pick one; Qwen Cloud is the default)
# Qwen: python3 scripts/setup_qwen.py prompts privately and writes the key here.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# TIWALA_LLM_PROVIDER=qwen   # qwen (default), deepseek, openrouter or anthropic; a provider without a key is skipped

# ---- Sepolia (live.sh fills in the keys it needs)
SEPOLIA_RPC_URL=                     # optional: your own RPC; a public one is used otherwise
PRIVATE_KEY=                         # deployer; created by live.sh if empty. Test ETH only, never real funds
OWNER_PRIVATE_KEY=                   # created by live.sh: the owner (human) key
AGENT_PRIVATE_KEY=                   # created by live.sh: the AI agent key
ACCOUNT_SALT=                        # created by live.sh: secret salt for account-fingerprint hashes
# Optional deploy settings
BUYER_FUND_WEI=2000000000000000      # test ETH per seeded buyer (owner and agent get twice this)
PAYEE_DELAY=600                      # seconds a newly saved payee waits before it can be paid (production: 86400)
LATE_WINDOW=2700                     # must exceed the deploy time (~107 txs at 12 s blocks)
DEMO_GRACE=600
ETHERSCAN_API_KEY=

# Agent RPC: needs eth_getLogs over wide ranges. Alchemy free tier allows 10 blocks (works, slowly).
# AGENT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# DASHSCOPE_BASE_URL is chosen from the key: Token Plan keys (sk-sp-...) use
#   https://token-plan.maas.qwencloudapi.com/compatible-mode/v1, others
#   https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1. Set it only to override.
# QWEN_ENABLE_THINKING=true
# Qwen defaults Coordinator/Treasury to qwen3.7-plus and Checker to qwen3.8-flash.
# Optional per-agent overrides. openrouter defaults all three to nvidia/nemotron-3-ultra-550b-a55b:free
# TIWALA_COORDINATOR_MODEL=
# TIWALA_TREASURY_MODEL=
# TIWALA_CHECKER_MODEL=

# Supplier negotiation
# TIWALA_SUPPLIER_AGENT=model        # or scripted (deterministic, labelled "not AI")
# TIWALA_SUPPLIER_AGENT_MODEL=
# TIWALA_NEGOTIATOR=model            # or rules (no buyer-side model calls)
# TIWALA_NEGOTIATOR_MODEL=
# TIWALA_SUPPLIER_CONSOLE_SECRET=    # signs supplier console links; random per run if unset
# TIWALA_DEMO_LINKS=1                # set 0 outside local demos

# WhatsApp Business Platform (Cloud API). Leave empty to use the local simulator only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                 # validates X-Hub-Signature-256 on webhook POSTs (docs/whatsapp-webhook.md)
WHATSAPP_VERIFY_TOKEN=               # your choice; also entered in the Meta app dashboard
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=              # approved template for messages outside the 24-hour window
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_LIVE_SEND=0                 # 1 only with explicit authorisation
WHATSAPP_ALLOWED_RECIPIENTS=         # comma-separated wa_ids that may receive messages

# Telegram bot (long polling: no webhook, no public URL). Create the bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=               # optional; read from getMe when empty
TELEGRAM_LIVE_SEND=0                 # 1 only with explicit authorisation
TELEGRAM_POLL=1                      # 0 stops the console from polling

# Deadlines are read in the device timezone. Override with an IANA name if needed.
# TIWALA_TZ=Asia/Manila

# Owner console: setup prompts for credentials; no shared default password.
# Default live username: owner. Override at first setup: TIWALA_LOGIN_USER=myname ./scripts/live.sh
# TIWALA_TRUSTED_PROXIES=127.0.0.1    # ONLY a private proxy that strips/rewrites forwarded headers
# Keep TIWALA_AUTH_DISABLED unset outside local screenshot tests.
