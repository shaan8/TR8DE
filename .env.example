# Copy to .env and fill in. Never commit .env.
SEPOLIA_RPC_URL=
# Funded Sepolia key: deployer = factory platform = tPHP issuer. Also funds the keys below.
PRIVATE_KEY=
# Demo MSME owner (human tier) and AI agent key. Must differ. Generate with: cast wallet new
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
# Secret salt for account-fingerprint hashes (off-chain only). Generate with: cast keccak "$(openssl rand -hex 32)"
ACCOUNT_SALT=
# Optional
BUYER_FUND_WEI=10000000000000000
LATE_WINDOW=2700   # Sepolia: must exceed the --slow broadcast time (~107 txs) or late createDeal reverts
DEMO_GRACE=600
ETHERSCAN_API_KEY=

# Agent runtime (DeepSeek)
DEEPSEEK_API_KEY=

# Agent RPC: needs eth_getLogs over wide ranges. Alchemy free tier allows 10 blocks (works, slowly).
# AGENT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# LLM provider: deepseek (default, final), qwen, openrouter (free testing), anthropic
TIWALA_LLM_PROVIDER=deepseek
OPENROUTER_API_KEY=
# Qwen: python3 scripts/setup_qwen.py prompts privately and configures the root .env.
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL is chosen from the key: Token Plan keys (sk-sp-...) use
#   https://token-plan.maas.qwencloudapi.com/compatible-mode/v1, others
#   https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1. Set it only to override.
# QWEN_ENABLE_THINKING=true
# Qwen defaults all wallet and negotiation agents to qwen3.7-plus.
# Optional per-agent overrides. openrouter defaults all three to nvidia/nemotron-3-ultra-550b-a55b:free
# TIWALA_COORDINATOR_MODEL=
# TIWALA_TREASURY_MODEL=
# TIWALA_CHECKER_MODEL=

# Supplier negotiation
# TIWALA_SUPPLIER_AGENT=model        # or scripted (deterministic, labelled "not AI")
# TIWALA_SUPPLIER_AGENT_MODEL=
# TIWALA_NEGOTIATOR=model            # or rules (no buyer-side model calls)
# TIWALA_NEGOTIATOR_MODEL=
# TIWALA_SUPPLIER_CONSOLE_SECRET=    # signs supplier console links; random per run if unset
# TIWALA_DEMO_LINKS=1                # set 0 outside local demos

# WhatsApp Business Platform (Cloud API). Leave empty to use the local simulator only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                 # validates X-Hub-Signature-256 on webhook POSTs
WHATSAPP_VERIFY_TOKEN=               # your choice; also entered in the Meta app dashboard
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=              # approved template for messages outside the 24-hour window
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_LIVE_SEND=0                 # 1 only with explicit authorisation
WHATSAPP_ALLOWED_RECIPIENTS=         # comma-separated wa_ids that may receive messages

# Deadlines are read in the device timezone. Override with an IANA name if needed.
# TIWALA_TZ=Asia/Manila
